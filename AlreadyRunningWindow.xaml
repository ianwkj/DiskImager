<Window x:Class="DiskImager.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskImager is already running" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Icon="app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <StackPanel Margin="22,20,22,20">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="46" Height="46" VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}" BorderBrush="White" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="ALREADY OPEN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="DiskImager is already running" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock x:Name="DetailText" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SwitchButton" Content="Switch to it" Tag="&#xE8A7;" Style="{StaticResource Primary}" IsDefault="True" Click="Switch_Click"/>
                <Button x:Name="CloseButton" Content="Close" IsCancel="True" Click="Close_Click" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
