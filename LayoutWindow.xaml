<Window x:Class="DiskImager.LayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose target and partition sizes" Width="860" SizeToContent="Height" MaxHeight="960"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="21" TextWrapping="Wrap"/>
            <TextBlock x:Name="Explain" TextWrapping="Wrap" Foreground="#475569" Margin="0,6,0,12"/>

            <GroupBox Header="Target drive">
                <StackPanel>
                    <ComboBox x:Name="TargetBox" SelectionChanged="TargetBox_SelectionChanged"/>
                    <TextBlock Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Any size works as long as the data fits. The disk Windows is running from can't be chosen."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Partition sizes">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton x:Name="AutoRadio" Content="Resize automatically to fit the target" IsChecked="True" Checked="Mode_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="KeepRadio" Content="Keep original sizes" Checked="Mode_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="CustomRadio" Content="Choose sizes myself" Checked="Mode_Changed"/>
                    </WrapPanel>
                    <TextBlock x:Name="SourceLabel" Foreground="#64748B" FontSize="12" Margin="0,0,0,3"/>
                    <ContentControl x:Name="SourceBarHost"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock x:Name="TargetSizeLabel" DockPanel.Dock="Right" Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="AfterLabel" Foreground="#64748B" FontSize="12"/>
                    </DockPanel>
                    <!-- The target drive: drag the handle on a partition's right edge to resize it. -->
                    <Canvas x:Name="DriveCanvas" Height="132" Background="Transparent" ClipToBounds="False"
                            SizeChanged="DriveCanvas_SizeChanged" MouseMove="DriveCanvas_MouseMove"
                            MouseLeftButtonUp="DriveCanvas_MouseUp" LostMouseCapture="DriveCanvas_LostMouseCapture"/>

                    <Border x:Name="SelectedPanel" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Selected:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SelectedName" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel x:Name="SelectedEdit" DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBox x:Name="SizeBox" Width="96" HorizontalContentAlignment="Right"
                                         KeyDown="SizeBox_KeyDown" LostKeyboardFocus="SizeBox_LostFocus"/>
                                <TextBlock Text="GB" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="#64748B"/>
                                <Button x:Name="FillButton" Content="Fill free space" Tag="&#xE740;" Click="Fill_Click" Padding="10,5"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectedHint" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="StatusBorder" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock x:Name="PlanStatus" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="StagingGroup" Header="Working space for shrinking" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StagingNote" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="&#xE8B7;" Click="BrowseStaging_Click" Margin="6,0,0,0"/>
                        <TextBox x:Name="StagingBox"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#991B1B" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="Everything currently on the target drive will be permanently erased."/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="NewIdsBox" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Width="760"
                           Text="Give the copy new disk IDs. Tick this only if both disks will stay in this PC as data disks. Leave it unticked if the new drive is replacing the old one, otherwise it won't boot."/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="To confirm, type the target disk number:" VerticalAlignment="Center"/>
                <TextBox x:Name="ConfirmBox" Width="50" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OkButton" Content="Erase and write" Tag="&#xE7BA;" Style="{StaticResource Danger}" Click="Ok_Click"/>
                <Button Content="Cancel" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
