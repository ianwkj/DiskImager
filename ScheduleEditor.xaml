<UserControl x:Class="DiskImager.ScheduleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="KindBox" Width="130" SelectionChanged="KindBox_SelectionChanged">
                <ComboBoxItem>Not scheduled</ComboBoxItem>
                <ComboBoxItem>Every day</ComboBoxItem>
                <ComboBoxItem>Weekly</ComboBoxItem>
                <ComboBoxItem>Monthly</ComboBoxItem>
            </ComboBox>
            <StackPanel x:Name="TimePanel" Orientation="Horizontal">
                <TextBlock Text="at" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox x:Name="TimeBox" Width="60" Text="22:00" ToolTip="24-hour time, e.g. 22:00"/>
            </StackPanel>
            <StackPanel x:Name="MonthPanel" Orientation="Horizontal">
                <TextBlock Text="on day" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox x:Name="DayBox" Width="40" Text="1" ToolTip="1–28 runs every month"/>
                <TextBlock Text="of the month" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <WrapPanel x:Name="DaysPanel" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
