<Window x:Class="DiskImager.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskImager – update available" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <StackPanel Margin="22,20,22,20">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/logo.png" Width="46" Height="46" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="UPDATE AVAILABLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock x:Name="CurrentText" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,16,0,0" x:Name="NotesBorder">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="CountText" FontSize="15" Margin="0,16,0,8" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Bar" Maximum="1" Value="1" Height="8"/>

            <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="UpdateButton" Content="Update now" Tag="&#xE896;" Style="{StaticResource Primary}" Click="Update_Click"/>
                <Button x:Name="LaterButton" Content="Later" Tag="&#xE823;" Click="Later_Click" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Powered by " Style="{StaticResource Hint}"/>
                <TextBlock Style="{StaticResource Hint}" FontWeight="SemiBold">
                    <Hyperlink NavigateUri="https://e-techsource.com" Style="{StaticResource BrandLink}" RequestNavigate="Link_RequestNavigate">TechSource Digital</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
