<Window x:Class="DiskImager.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="22,18,22,18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="26"
                       Foreground="{StaticResource Accent}" Margin="0,2,14,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="This backup is encrypted" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <PasswordBox x:Name="PassBox" Margin="0,16,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Unlock" Tag="&#xE785;" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
