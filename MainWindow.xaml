<Window x:Class="DiskImager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskImager – Powered by TechSource Digital" Height="820" Width="1260" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar background + branding footer -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}"/>
        <StackPanel Grid.RowSpan="2" Margin="24,0,20,18" VerticalAlignment="Bottom" Panel.ZIndex="1">
            <Border Height="1" Background="#1E293B" Margin="0,0,0,14"/>
            <TextBlock Text="POWERED BY" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0">
                <Hyperlink NavigateUri="https://e-techsource.com" Style="{StaticResource SidebarLink}" RequestNavigate="Link_RequestNavigate">TechSource Digital</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="VersionText" Text="Version 1.0" Foreground="#475569" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.ColumnSpan="2" Style="{StaticResource SideNav}">

            <!-- ======================================================== DISKS -->
            <TabItem Header="Disks" Tag="&#xEDA2;" Style="{StaticResource NavItem}">
                <DockPanel x:Name="DisksPanel">
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Refresh" Tag="&#xE72C;" Click="Refresh_Click"/>
                            <Button Content="Clone disk…" Tag="&#xE8C8;" Click="CloneDisk_Click"/>
                            <Button Content="Image disk…" Tag="&#xE74E;" Style="{StaticResource Primary}" Click="ImageDisk_Click" Margin="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Disks" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Every drive connected to this PC. Select one to back it up as an image, or clone it straight to another drive."
                                       Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="DiskList" ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"/>
                </DockPanel>
            </TabItem>

            <!-- ======================================================== JOBS -->
            <TabItem Header="Scheduled backups" Tag="&#xE787;" Style="{StaticResource NavItem}">
                <DockPanel x:Name="JobsPanel">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="New job…" Tag="&#xE710;" Style="{StaticResource Primary}" Click="NewJob_Click"
                                VerticalAlignment="Top" Margin="0"/>
                        <StackPanel>
                            <TextBlock Text="Scheduled backups" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Jobs run automatically in the background, even when nobody is signed in. Double-click a job to edit it."
                                       Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Run full now" Tag="&#xE768;" Click="RunFull_Click"/>
                        <Button Content="Run incremental now" Tag="&#xE768;" Click="RunIncr_Click"/>
                        <Button Content="Edit" Tag="&#xE70F;" Click="EditJob_Click"/>
                        <Button Content="Delete" Tag="&#xE74D;" Click="DeleteJob_Click" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="1">
                        <DataGrid x:Name="JobsGrid" MouseDoubleClick="EditJob_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1*" MinWidth="110" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="SOURCE DISK" Binding="{Binding Source}" Width="1.3*" MinWidth="120"/>
                                <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}" Width="1.2*" MinWidth="110"/>
                                <DataGridTextColumn Header="FULL" Binding="{Binding Full}" Width="1.1*" MinWidth="110"/>
                                <DataGridTextColumn Header="INCREMENTAL" Binding="{Binding Incremental}" Width="1.1*" MinWidth="110"/>
                                <DataGridTextColumn Header="KEEP" Binding="{Binding Keep}" Width="65"/>
                                <DataGridTextColumn Header="AFTER" Binding="{Binding After}" Width="75"/>
                                <DataGridTextColumn Header="LAST RUN" Binding="{Binding LastRun}" Width="1.4*" MinWidth="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ======================================================== RESTORE -->
            <TabItem Header="Restore" Tag="&#xE777;" Style="{StaticResource NavItem}">
                <DockPanel x:Name="RestorePanel">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Restore" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Bring a disk back from an image: on this PC, another drive, or a NAS. Partitions can be resized to fit a smaller or larger drive."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Image location" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBox x:Name="LocationBox" Grid.Column="1" ToolTip="A local folder, another drive, or a network path like \\NAS\Backups"
                                     TextChanged="LocationBox_TextChanged"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Browse…" Tag="&#xE8B7;" Click="BrowseLocation_Click"/>
                                <Button Content="Find images" Tag="&#xE721;" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0"/>
                            </StackPanel>
                            <StackPanel x:Name="RestoreNetPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="Network user" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="RestoreUserBox" Width="180" ToolTip="e.g. NAS\admin"/>
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
                                <PasswordBox x:Name="RestorePassBox" Width="160"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore to selected drive…" Tag="&#xE777;" Style="{StaticResource Primary}"
                                    Click="Restore_Click" Margin="0" IsEnabled="False"
                                    ToolTip="Select a backup first" ToolTipService.ShowOnDisabled="True"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VerifyButton" Content="Verify image" Tag="&#xE73E;" Click="Verify_Click" IsEnabled="False"
                                        ToolTip="Select a backup first" ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="110"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.3*" MinHeight="130"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pick the backup point" FontWeight="SemiBold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  incrementals restore the disk exactly as it was at that time" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="1">
                            <DataGrid x:Name="ImagesGrid" SelectionChanged="ImagesGrid_SelectionChanged">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <!-- Right-click selects the row before the menu opens. -->
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ImageRow_RightClick"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy file path" Click="CopyImagePath_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding Created}" Width="140" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="115"/>
                                    <DataGridTextColumn Header="JOB" Binding="{Binding Job}" Width="130"/>
                                    <DataGridTextColumn Header="COMPUTER" Binding="{Binding Computer}" Width="110"/>
                                    <DataGridTextColumn Header="SOURCE DISK" Binding="{Binding Disk}" Width="200"/>
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="80"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="FILE" Binding="{Binding File}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                        <DockPanel Grid.Row="3" Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Content="Refresh drives" Tag="&#xE72C;" Click="Refresh_Click" Margin="0" Padding="10,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pick the drive to restore to" FontWeight="SemiBold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  drives connected to this PC" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="RestoreDiskList" Grid.Row="4" ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ======================================================== SETTINGS -->
            <TabItem Header="Settings" Tag="&#xE713;" Style="{StaticResource NavItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Email notifications, updates and information about DiskImager." Style="{StaticResource PageSubtitle}"/>

                        <GroupBox Header="Email notifications">
                            <StackPanel>
                                <CheckBox x:Name="EmailEnabledBox" Margin="0,4,0,14"
                                          Content="Send emails when backup jobs finish (each job chooses: never, only on failure, or every time)"/>
                                <Grid x:Name="EmailGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="SMTP server" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="SmtpHostBox" Width="280" ToolTip="e.g. smtp.gmail.com, smtp.office365.com"/>
                                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
                                        <TextBox x:Name="SmtpPortBox" Width="70" Text="587"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Security" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="SmtpSecurityBox" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,4" SelectedIndex="0">
                                        <ComboBoxItem>Automatic (recommended)</ComboBoxItem>
                                        <ComboBoxItem>STARTTLS (usually port 587)</ComboBoxItem>
                                        <ComboBoxItem>SSL/TLS (usually port 465)</ComboBoxItem>
                                        <ComboBoxItem>None (unencrypted, usually port 25)</ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="SmtpUserBox" Width="280" ToolTip="Usually your full email address. Leave empty if the server needs no login."/>
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
                                        <PasswordBox x:Name="SmtpPassBox" Width="180"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Text="From address" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SmtpFromBox" Grid.Row="3" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,4"
                                             ToolTip="Leave empty to use the username"/>

                                    <TextBlock Grid.Row="4" Text="Send to" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SmtpToBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                                             ToolTip="One or more addresses, separated by commas"/>

                                    <Border Grid.Row="5" Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Style="{StaticResource Hint}" Width="560"
                                                       Text="Gmail: smtp.gmail.com, port 587, with an App Password (Google Account → Security → App passwords) instead of your normal password. Outlook / Microsoft 365: smtp.office365.com, port 587. Most NAS and ISP mail servers work too."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Save" Tag="&#xE74E;" Style="{StaticResource Primary}" Click="SaveEmail_Click"/>
                                    <Button Content="Send test email" Tag="&#xE715;" Click="TestEmail_Click"/>
                                    <TextBlock x:Name="EmailStatus" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox x:Name="AutoUpdateBox" Content="Check for updates when DiskImager opens" Click="AutoUpdate_Click"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="26,4,0,0" TextWrapping="Wrap"
                                           Text="A new version installs itself after a 10-second countdown unless you click Later. Never while a backup is running."/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="CheckUpdateButton" Content="Check for updates now" Tag="&#xE895;" Click="CheckUpdates_Click"/>
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" MaxWidth="460"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="About">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image Source="pack://application:,,,/logo.png" Width="60" Height="60" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="DiskImager" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutVersion" Text="Version 1.0" Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                                    <TextBlock Text="Disk imaging, cloning, scheduled backups and restore for Windows." TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Powered by " Foreground="{StaticResource Muted}"/>
                                        <TextBlock FontWeight="SemiBold">
                                            <Hyperlink NavigateUri="https://e-techsource.com" Style="{StaticResource BrandLink}" RequestNavigate="Link_RequestNavigate">TechSource Digital</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== LOG -->
            <TabItem Header="Activity log" Tag="&#xE8FD;" Style="{StaticResource NavItem}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="Open log folder" Tag="&#xE838;" Click="OpenLogs_Click" VerticalAlignment="Top" Margin="0"/>
                        <StackPanel>
                            <TextBlock Text="Activity log" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Everything DiskImager does, including scheduled runs (saved in C:\ProgramData\DiskImager\Logs)."
                                       Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                             Background="White" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource CardBorder}" Padding="14,12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Status / progress bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- The bar starts right after the status text and fills the rest; long messages are shortened with "…". -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" MaxWidth="440">
                    <!-- Lined up with the first text line (the detail line below it is hidden when empty). -->
                    <Border x:Name="StatusDot" DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="#22C55E"
                            VerticalAlignment="Top" Margin="0,5,12,0"/>
                    <StackPanel>
                        <TextBlock x:Name="StageText" Text="Ready" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="Progress" Grid.Column="1" Margin="20,0" Maximum="100" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="When finished" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AfterCombo" Width="130" SelectedIndex="0">
                        <ComboBoxItem>Do nothing</ComboBoxItem>
                        <ComboBoxItem>Shut down</ComboBoxItem>
                        <ComboBoxItem>Restart</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Tag="&#xE711;" IsEnabled="False" Click="Cancel_Click" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
