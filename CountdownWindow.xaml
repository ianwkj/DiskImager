<Window x:Class="DiskImager.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskImager – scheduled backup" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" ShowActivated="True" Icon="app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <StackPanel Margin="22,20,22,20">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/logo.png" Width="46" Height="46" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="SCHEDULED BACKUP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="JobText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="DescText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="CountText" FontSize="15" Margin="0,18,0,8"/>
            <ProgressBar x:Name="Bar" Maximum="1" Value="1" Height="8"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="StartButton" Content="Start now" Tag="&#xE768;" Style="{StaticResource Primary}" Click="Start_Click"/>
                <Button x:Name="PostponeButton" Content="Postpone" Tag="&#xE823;" Click="Postpone_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="15 minutes" Tag="15" Click="PostponeFor_Click"/>
                            <MenuItem Header="30 minutes" Tag="30" Click="PostponeFor_Click"/>
                            <MenuItem Header="1 hour" Tag="60" Click="PostponeFor_Click"/>
                            <MenuItem Header="2 hours" Tag="120" Click="PostponeFor_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Cancel backup" Tag="&#xE711;" Foreground="{StaticResource DangerBrush}" Click="Cancel_Click" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Powered by " Style="{StaticResource Hint}"/>
                <TextBlock Style="{StaticResource Hint}" FontWeight="SemiBold">
                    <Hyperlink NavigateUri="https://e-techsource.com" Style="{StaticResource BrandLink}" RequestNavigate="Link_RequestNavigate">TechSource Digital</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
