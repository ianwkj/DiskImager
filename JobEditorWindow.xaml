<Window x:Class="DiskImager.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskImager"
        Title="Backup job" Width="900" Height="640" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- Steps in the dark rail: same look as the main window's menu. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,10" Margin="10,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A quick-add folder button that's switched on. -->
        <Style x:Key="ChipOn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="21"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== step rail -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,12,22">
                    <Image Source="pack://application:,,,/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RailTitle" Text="New backup job" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                        <TextBlock Text="DiskImager" Foreground="#94A3B8" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,20,16">
                    <Border Height="1" Background="#1E293B" Margin="0,0,0,12"/>
                    <TextBlock Text="POWERED BY" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="TechSource Digital" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="STEPS" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold" Margin="24,0,0,6"/>
                    <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RailItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StepList_SelectionChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================================== pages + bottom bar -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="26,12">
                <DockPanel>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="Back" Tag="&#xE72B;" Click="Back_Click"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SkipButton" Content="Skip" Click="Skip_Click" Visibility="Collapsed"/>
                        <Button Content="Cancel" IsCancel="True"/>
                        <Button x:Name="OkButton" Content="Next" Tag="&#xE72A;" Style="{StaticResource Primary}" IsDefault="True" Click="Next_Click" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="StepText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0"/>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
                <Grid Margin="26,22,26,12">

                    <!-- 1. Disk -->
                    <StackPanel x:Name="DiskPage">
                        <TextBlock x:Name="Heading" Style="{StaticResource StepTitle}" Text="Which disk do you want to back up?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="The whole disk is imaged, with every partition on it."/>
                        <ListBox x:Name="DiskList" ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent" Margin="0,0,0,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 PreviewMouseWheel="Inner_PreviewMouseWheel"/>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock Text="Job name" Width="110" VerticalAlignment="Center" Foreground="#334155"/>
                                <TextBox x:Name="NameBox"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. Location -->
                    <StackPanel x:Name="LocationPage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Where should the backups go?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="A folder on another drive, a USB drive, or a NAS share."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Save images to"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Test" Tag="&#xE73E;" Click="Test_Click" Margin="6,0,0,0" MinWidth="60"/>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Tag="&#xE8B7;" Click="Browse_Click" Margin="6,0,0,0"/>
                                    <TextBox x:Name="DestBox" TextChanged="DestBox_TextChanged"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Use the \\server\share form for a NAS, not a mapped drive letter. For the weekly report, give each PC its own folder in one office share, e.g. \\NAS\Backups\FrontDesk."/>
                                <StackPanel x:Name="NetPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="NetLabel" Text="Network login" Width="110" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBox x:Name="UserBox" Width="180" ToolTip="e.g. NAS\backupuser"/>
                                    <TextBlock Text="Password" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="#334155"/>
                                    <PasswordBox x:Name="PassBox" Width="160"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Options"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Compression" Width="110" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox x:Name="CompressionBox" Width="230">
                                        <ComboBoxItem>Fast (recommended)</ComboBoxItem>
                                        <ComboBoxItem>Smaller files (slower)</ComboBoxItem>
                                        <ComboBoxItem>None</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="VerifyBox" Content="Verify the image when it's done" Margin="0,14,0,0"
                                          ToolTip="Re-reads the new backup and checks every block. For incrementals only what that run added is checked, so daily runs stay quick."/>
                                <CheckBox x:Name="TrackBox" Content="Faster incrementals: only read what changed" Margin="0,8,0,0"
                                          ToolTip="Uses Windows' NTFS change journal to skip parts of the disk that haven't changed since the last backup. A sample of the skipped parts is checked every time; if anything is uncertain, the whole disk is read as usual."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. Exclude folders -->
                    <StackPanel x:Name="ExcludePage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Leave any folders out?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Their files aren't backed up, and a restored PC gets these folders back empty. You can skip this to back up everything."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Quick add"/>
                                <WrapPanel x:Name="QuickPanel"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Content="Browse for a folder…" Tag="&#xE8B7;" Click="BrowseExclude_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Add" Tag="&#xE710;" Click="AddExclude_Click" Margin="8,0,0,0"/>
                                    <TextBox x:Name="ExcludePathBox" ToolTip="A full folder path. * matches any name, e.g. C:\Users\*\Music" PreviewKeyDown="ExcludePathBox_KeyDown"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Or type a path and click Add. * matches any name, so C:\Users\*\Music covers every user."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="0,14,0,6">
                            <StackPanel>
                                <TextBlock x:Name="ExcludeCount" Style="{StaticResource CardTitle}" Margin="16,0,16,6" Text="Left out"/>
                                <StackPanel x:Name="ExcludeList"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Encryption -->
                    <StackPanel x:Name="EncryptPage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Encrypt these backups?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Anyone holding the backup files would need the password to restore them. You can skip this."/>
                        <ListBox x:Name="EncryptChoice" ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent" SelectionChanged="EncryptChoice_SelectionChanged"/>
                        <Border x:Name="EncryptPanel" Style="{StaticResource Card}" Margin="0,4,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Password" Width="110" VerticalAlignment="Center" Foreground="#334155"/>
                                    <PasswordBox x:Name="EncPass1" Width="180"/>
                                    <TextBlock Text="Again" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#334155"/>
                                    <PasswordBox x:Name="EncPass2" Width="180"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Keep it somewhere safe, such as your password manager. Without it, nobody can restore these backups. Changing it starts a new full backup."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5a. Schedule (scheduled jobs) -->
                    <StackPanel x:Name="SchedulePage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="When should it run?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Backups run in the background, even when nobody is signed in."/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Full backup" Margin="0,6,0,0" Foreground="#334155"/>
                                <local:ScheduleEditor x:Name="FullSchedule" Grid.Column="1" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="1" Text="Incremental" Margin="0,6,0,0" Foreground="#334155"/>
                                <local:ScheduleEditor x:Name="IncrSchedule" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="2" Text="When done" VerticalAlignment="Center" Foreground="#334155"/>
                                <ComboBox x:Name="AfterBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,3">
                                    <ComboBoxItem>Do nothing</ComboBoxItem>
                                    <ComboBoxItem>Shut down the PC</ComboBoxItem>
                                    <ComboBoxItem>Restart the PC</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Text="Email me" VerticalAlignment="Center" Foreground="#334155"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="NotifyBox" Width="180">
                                        <ComboBoxItem>Never</ComboBoxItem>
                                        <ComboBoxItem>Only if it fails</ComboBoxItem>
                                        <ComboBoxItem>Every time</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock x:Name="NotifyHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="WakeBox" Grid.Row="4" Grid.Column="1" Content="Wake the computer from sleep to run this job" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                        <!-- Other PCs' backup times at the same place, so two PCs don't back up at once. -->
                        <Border x:Name="OthersCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Check again" Tag="&#xE72C;" Click="RefreshOthers_Click" Margin="0" Padding="10,4"/>
                                    <StackPanel>
                                        <TextBlock x:Name="OthersTitle" Style="{StaticResource CardTitle}" Margin="0" Text="Other backups at this location"/>
                                        <TextBlock x:Name="OthersWhere" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="ClashPanel"/>
                                <StackPanel x:Name="OthersList"/>
                                <TextBlock x:Name="OthersHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5b. Backup type (one-off "Image disk") -->
                    <StackPanel x:Name="TypePage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Full or incremental?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="A full image stands on its own. An incremental only saves what changed since the last image of this job in that folder."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <RadioButton x:Name="OneOffFull" Content="Full: a complete, stand-alone image" IsChecked="True" Margin="0,2"/>
                                <RadioButton x:Name="OneOffIncr" Content="Incremental: only what changed since the last image" Margin="0,8,0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. Old backups -->
                    <StackPanel x:Name="RetentionPage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="How many old backups to keep?"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Older ones are deleted automatically to save space."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Keep the last" VerticalAlignment="Center"/>
                                    <TextBox x:Name="KeepBox" Width="48" Margin="8,0" Text="2" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="full backups" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Each one is kept with its incrementals. 0 keeps everything."/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <TextBlock Text="Start a fresh full backup every" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MaxIncrBox" Width="48" Margin="8,0" Text="6" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="incrementals" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="0 means only on the full backup schedule."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 7. Review -->
                    <StackPanel x:Name="ReviewPage">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Check and save"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Click a step on the left to change anything."/>
                        <Border Style="{StaticResource Card}" Padding="16,4">
                            <Grid x:Name="ReviewGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
