<Window x:Class="DiskImager.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskImager"
        Title="Backup job" Width="680" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="Heading" Text="Backup job" Style="{StaticResource PageTitle}" FontSize="21" Margin="0,0,0,16"/>

            <GroupBox Header="What and where">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Job name" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Text="Disk to back up" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <ListBox x:Name="DiskList" Grid.Row="1" Grid.Column="1" Margin="0,4,0,6" MaxHeight="300"
                             ItemContainerStyle="{StaticResource CardItem}" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"/>

                    <TextBlock Grid.Row="2" Text="Save images to" VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                        <Button DockPanel.Dock="Right" Content="Test" Tag="&#xE73E;" Click="Test_Click" Margin="6,0,0,0" MinWidth="60"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Tag="&#xE8B7;" Click="Browse_Click" Margin="6,0,0,0"/>
                        <TextBox x:Name="DestBox" TextChanged="DestBox_TextChanged"/>
                    </DockPanel>
                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="A folder on another disk (E:\Backups), a USB drive, or a NAS / network share (\\NAS\Backups\PC1). For scheduled jobs use the \\server\share form, not a mapped drive letter."/>

                    <TextBlock x:Name="NetLabel" Grid.Row="4" Text="Network login" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel x:Name="NetPanel" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3" Visibility="Collapsed">
                        <TextBox x:Name="UserBox" Width="180" ToolTip="e.g. NAS\backupuser (leave empty for local disks)"/>
                        <TextBlock Text="Password" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <PasswordBox x:Name="PassBox" Width="160"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Text="Compression" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CompressionBox" Grid.Row="5" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,3">
                        <ComboBoxItem>Fast (recommended)</ComboBoxItem>
                        <ComboBoxItem>Smaller files (slower)</ComboBoxItem>
                        <ComboBoxItem>None</ComboBoxItem>
                    </ComboBox>

                    <CheckBox x:Name="VerifyBox" Grid.Row="6" Grid.Column="1" Margin="0,10,0,2"
                              Content="Verify image when complete"
                              ToolTip="Re-reads the new backup and checks every block. For incrementals only what that run added is checked, so daily runs stay quick."/>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="OneOffGroup" Header="Backup type">
                <StackPanel>
                    <RadioButton x:Name="OneOffFull" Content="Full – a complete, stand-alone image" IsChecked="True" Margin="0,2"/>
                    <RadioButton x:Name="OneOffIncr" Content="Incremental – only what changed since the last image of this job in that folder" Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ScheduleGroup" Header="Schedule">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Full backup" Margin="0,6,0,0"/>
                    <local:ScheduleEditor x:Name="FullSchedule" Grid.Column="1" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="1" Text="Incremental backup" Margin="0,6,0,0"/>
                    <local:ScheduleEditor x:Name="IncrSchedule" Grid.Row="1" Grid.Column="1" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="2" Text="When done" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AfterBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,3">
                        <ComboBoxItem>Do nothing</ComboBoxItem>
                        <ComboBoxItem>Shut down the PC</ComboBoxItem>
                        <ComboBoxItem>Restart the PC</ComboBoxItem>
                        <ComboBoxItem>Sleep</ComboBoxItem>
                        <ComboBoxItem>Hibernate</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="Email me" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <ComboBox x:Name="NotifyBox" Width="180">
                            <ComboBoxItem>Never</ComboBoxItem>
                            <ComboBoxItem>Only if it fails</ComboBoxItem>
                            <ComboBoxItem>Every time</ComboBoxItem>
                        </ComboBox>
                        <TextBlock x:Name="NotifyHint" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="WakeBox" Grid.Row="4" Grid.Column="1" Content="Wake the computer from sleep to run this job" Margin="0,6,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="RetentionGroup" Header="Old backups">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Keep the last" VerticalAlignment="Center"/>
                        <TextBox x:Name="KeepBox" Width="48" Margin="8,0" Text="2" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="full backups" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Each one is kept with its incrementals. Older ones are deleted automatically. 0 = keep everything."/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,2">
                        <TextBlock Text="Start a fresh full backup every" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxIncrBox" Width="48" Margin="8,0" Text="6" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="incrementals" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="0 = only on the full backup schedule."/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="OkButton" Content="Save job" Tag="&#xE74E;" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
                <Button Content="Cancel" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
