<Window x:Class="DiskImagerSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskImager Setup" Width="680" Height="460" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="26,30,22,24">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="POWERED BY" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0">
                        <Hyperlink NavigateUri="https://e-techsource.com" RequestNavigate="Link_RequestNavigate"
                                   Foreground="White" TextDecorations="{x:Null}" Cursor="Hand" ToolTip="e-techsource.com">TechSource Digital</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <Image Source="pack://application:,,,/logo.png" Width="72" Height="72" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DiskImager" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock x:Name="VersionText" Foreground="#BFDBFE" FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="Disk imaging, cloning, scheduled backups and restore for Windows."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="32,30,30,24">
            <!-- 1. Options -->
            <DockPanel x:Name="WelcomePage">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Primary}" Click="Install_Click" IsDefault="True" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="WelcomeTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="WelcomeText" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>

                    <TextBlock Text="Install location" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,6,0,18">
                        <TextBlock x:Name="LocationText" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <CheckBox x:Name="DesktopBox" Content="Create a desktop shortcut" IsChecked="True"/>
                    <CheckBox x:Name="StartMenuBox" Content="Add DiskImager to the Start menu" IsChecked="True"/>
                    <CheckBox x:Name="LaunchBox" Content="Open DiskImager when setup finishes" IsChecked="True"/>
                </StackPanel>
            </DockPanel>

            <!-- 2. Progress -->
            <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Installing DiskImager…" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,10,0,14"/>
                <ProgressBar x:Name="Bar" Maximum="1"/>
            </StackPanel>

            <!-- 3. Finished / problem -->
            <DockPanel x:Name="DonePage" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource Primary}" Click="Install_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource Primary}" Click="Finish_Click" IsDefault="True"/>
                </StackPanel>
                <StackPanel>
                    <Border x:Name="DoneBadge" Width="52" Height="52" CornerRadius="26" Background="#DCFCE7" HorizontalAlignment="Left">
                        <TextBlock x:Name="DoneIcon" Text="✓" FontSize="26" FontWeight="Bold" Foreground="#16A34A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DoneTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,16,0,0"/>
                    <TextBlock x:Name="DoneText" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
