<Project Sdk="Microsoft.NET.Sdk">

  <!-- Setup program. Targets .NET Framework 4.8 (built into Windows 10/11) so it runs on any PC
       without installing anything first; DiskImager itself is carried inside as an embedded resource. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <AssemblyName>DiskImagerSetup</AssemblyName>
    <RootNamespace>DiskImagerSetup</RootNamespace>
    <Version>1.3.0</Version>
    <Product>DiskImager Setup</Product>
    <Company>TechSource Digital</Company>
    <Authors>TechSource Digital</Authors>
    <Copyright>© 2026 TechSource Digital</Copyright>
    <Description>Installs DiskImager. Powered by TechSource Digital.</Description>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Produced by build-release.ps1 from the published single-file DiskImager.exe. -->
    <EmbeddedResource Include="payload\DiskImager.exe" LogicalName="payload.exe" />
    <Resource Include="..\..\logo.png" Link="logo.png" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>

