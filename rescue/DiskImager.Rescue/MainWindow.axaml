<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskImager.Rescue.MainWindow"
        Title="DiskImager Rescue" Width="1100" Height="760" MinWidth="820" MinHeight="560"
        Background="#F1F5F9" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top bar: brand, network, power -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image x:Name="Logo" Width="28" Height="28"/>
                    <TextBlock Text="DiskImager Rescue" Foreground="White" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="NetText" Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="HomeButton" Classes="topbar" Content="Start" ToolTip.Tip="Back to the start"/>
                    <Button x:Name="PowerButton" Classes="topbar" Content="⏻ Power">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem x:Name="RestartItem" Header="Restart"/>
                                <MenuItem x:Name="ShutdownItem" Header="Shut down"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Panel/>
            </DockPanel>
        </Border>

        <!-- Step chips (restore / browse flows) -->
        <Border x:Name="StepsBar" DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10" IsVisible="False">
            <StackPanel x:Name="Steps" Orientation="Horizontal" Spacing="8"/>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="VersionText" Foreground="#94A3B8" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Powered by" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="TechSource Digital" Foreground="#2563EB" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="Host" Margin="28,22,28,22" MaxWidth="1000"/>
        </ScrollViewer>
    </DockPanel>
</Window>
