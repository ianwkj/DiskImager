#!/bin/sh
# Keep the image small: no documentation, man pages or translations other than English.
set -e
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/help/*
find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' ! -name 'locale.alias' -exec rm -rf {} +
find /usr/lib/libreoffice/share/extensions -mindepth 1 -maxdepth 1 -name 'wiki-publisher' -exec rm -rf {} + 2>/dev/null || true
# The rescue app, the network applet and the desktop tweaks start at sign-in (see /etc/xdg/autostart).
systemctl enable NetworkManager || true
systemctl disable ssh 2>/dev/null || true
apt-get clean
rm -rf /var/lib/apt/lists/*
