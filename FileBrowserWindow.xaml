<Window x:Class="DiskImager.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse backup" Width="960" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,12" TextWrapping="Wrap"/>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Drive" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="VolumeBox" Width="260" SelectionChanged="VolumeBox_SelectionChanged"/>
                <Button x:Name="UpButton" Content="Up" Tag="&#xE74A;" Click="Up_Click" Margin="12,0,0,0"/>
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="8,0,0,0">
                    <TextBlock x:Name="PathText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="Copy selected to…" Tag="&#xE8C8;" Style="{StaticResource Primary}" Click="Copy_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Content="Stop" Tag="&#xE711;" Click="Cancel_Click" Visibility="Collapsed"/>
                <Button Content="Close" Click="Close_Click" Margin="0"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8">
                <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent" Margin="4"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DataGrid x:Name="FileGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      HeadersVisibility="Column" MouseDoubleClick="FileGrid_MouseDoubleClick" SelectionChanged="FileGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding IconBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="140" SortMemberPath="Sort"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
